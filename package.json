{
  "name": "dkb-dashboard-frontend-tests",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check:types": "tsc --project tsconfig.frontend.json",
    "dev": "vite",
    "format": "prettier --write \"frontend/**/*.{css,html,js,json,ts,tsx}\" \"*.{json,js,ts}\" \"*.yml\" \"tests/browser/**/*.js\" \".github/**/*.yml\"",
    "format:check": "prettier --check \"frontend/**/*.{css,html,js,json,ts,tsx}\" \"*.{json,js,ts}\" \"*.yml\" \"tests/browser/**/*.js\" \".github/**/*.yml\"",
    "lint": "eslint frontend/src vite.config.ts",
    "test:unit": "vitest run",
    "test:components": "playwright test",
    "test:integration": "bash scripts/test-integration.sh",
    "test:integrations": "npm run test:integration",
    "test:e2e:production": "bash scripts/test-production-e2e.sh",
    "test:deployment": "bash scripts/test-deployment.sh",
    "test:all": "cargo build --locked && npm run test:unit && npm run test:components && npm run test:integrations && npm run test:e2e:production && npm run test:deployment"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  }
}
