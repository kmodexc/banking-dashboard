# Browser application
# Docker Compose publishes only on 127.0.0.1. Set the host port here.
APP_PORT=8080
# Match this origin (and the Keycloak client URLs) to your dashboard URL.
ALLOWED_ORIGINS=http://localhost:8080
ALLOWED_HOSTS=localhost,127.0.0.1
# Leave empty when Apache serves both the frontend and API on the same domain.
PUBLIC_API_BASE_URL=
# Keycloak public client configuration
# Use the issuer URL for the realm, not only the Keycloak host.
KEYCLOAK_ISSUER=https://auth.example.com/realms/example
KEYCLOAK_CLIENT_ID=finance-dashboard
# Prefer a dedicated API audience when one is configured in Keycloak.
KEYCLOAK_AUDIENCE=

# Google Gemini Configuration
GEMINI_API_KEY=replace-with-server-side-key
GEMINI_MODEL=gemini-3.1-flash-lite
MAX_CLASSIFICATION_TRANSACTIONS=500
MAX_CLASSIFICATION_REQUEST_BYTES=262144
CLASSIFICATION_REQUESTS_PER_MINUTE=10

# PostgreSQL stores opt-in private/community rules transactionally.
POSTGRES_DB=dkb_dashboard
POSTGRES_USER=dkb_dashboard
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgres://dkb_dashboard:replace-with-a-long-random-password@db:5432/dkb_dashboard
# Optional one-time migration source for the former JSON store.
LEGACY_RULE_STORE_PATH=/legacy-data/dkb-rules.json
